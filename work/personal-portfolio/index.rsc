35:["$","div",null,{"className":"mt-8","children":[["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Overview"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[["$","p",null,{"children":"This is the portfolio you're reading right now, built as a real product rather than a static resume. It runs on Next.js 15's App Router with React 19 and strict TypeScript, layered over MongoDB, NextAuth, Nodemailer, and a mix of ogl/three.js WebGL that stays cheap because it only renders when it's actually on screen. Every visible feature — the guestbook, the live GitHub activity graph, the contact flow — is backed by a real database, real OAuth, and shared validation. The whole thing is tuned to hold a 95+ Lighthouse score while still feeling animated and alive, and it's engineered for both classic search crawlers and the newer AI answer engines."}],["$","p",null,{"children":"A developer-first, full-stack portfolio that combines refined UI/UX, smooth animations, and practical utility into a high-performance digital presence, optimized for SEO and accessibility."}]]}]]}],["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Key Features"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$","ul",null,{"className":"space-y-3","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"SEO-first architecture with semantic HTML and 95+ Lighthouse scores."}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Secure OAuth authentication via NextAuth (GitHub & Google)."}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Interactive MongoDB-powered guestbook showcasing full-stack capability."}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Polished UI/UX with smooth Motion.dev animations and scroll effects."}]]}],["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Built-in scheduling via Cal.com with automated branded emails."}]]}]]}]}]]}],[["$","section","0",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Why I Built This"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"Most developer portfolios are a screenshot wall — a grid of projects you can't touch, describing skills the site itself never demonstrates. I wanted mine to prove the claims it makes by being a production application: real GitHub + Google OAuth, a real MongoDB-backed guestbook people can sign, a contact form that actually sends branded transactional email, and a live GitHub contribution graph pulled from the GraphQL API. If the site says I can build full-stack systems, the site should *be* one."}],"$L38"],"$undefined","$undefined"]}]]}],"$L39","$L3a","$L3b","$L3c","$L3d","$L3e"],"$L3f"]}]
36:["$","div",null,{"className":"mt-16 border-t border-white/10 pt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6","children":[["$","div",null,{"children":[["$","h3",null,{"className":"text-xl font-semibold text-white","children":"Like what you see?"}],["$","p",null,{"className":"text-neutral-400 text-sm mt-1","children":"Explore more work or get in touch."}]]}],["$","div",null,{"className":"flex items-center gap-3","children":[["$","$L29",null,{"href":"/workspace","className":"inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/15 text-sm text-neutral-200 hover:bg-white/5 transition-colors","children":"More Projects"}],["$","$L29",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-black text-sm font-semibold hover:bg-neutral-200 transition-colors","children":["Get in Touch",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}]
38:["$","p","1",{"children":"It also had to earn its traffic. A portfolio nobody can find is worthless, so SEO and answer-engine optimization were first-class concerns from day one, not bolted on at the end — and so was performance, because a slow, janky site undercuts every word on it. On top of that, I rebuilt the whole thing from a loose JavaScript codebase into strict TypeScript with a single shared validation layer, because I wanted a codebase I'd actually be comfortable handing a reviewer."}]
39:["$","section","1",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Architecture Overview"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"The app is App-Router-first: React Server Components are the default and client interactivity is pushed out to the leaves. Tailwind v4 runs CSS-first with no config file, styled-components v6 survives as a few legacy islands behind an SSR registry (which fixes FOUC and hydration mismatches), MDX powers the content layer, and Biome plus ESLint keep it honest. Heavy WebGL and the guestbook are the only large client boundaries — everything else renders on the server."}]],["$","div",null,{"className":"rounded-xl border border-white/10 bg-white/[0.02] overflow-x-auto","children":["$","pre",null,{"className":"p-4 text-[12.5px] leading-relaxed font-mono text-neutral-300","children":["$","code",null,{"children":"app/\n  layout.tsx            # metadata API + JSON-LD + fonts + providers\n  page.tsx              # RSC home; client leaves for WebGL\n  work/[slug]/page.tsx  # SSG case-study pages (generateStaticParams)\n  api/\n    og/route.tsx        # edge dynamic OG card (ImageResponse)\n    comments/route.ts   # guestbook: auth POST + Mongoose populate\n    messages/route.ts   # contact: Zod + rate-limit + Nodemailer\n    github/contributions/route.ts\n    auth/[...nextauth]/route.ts\n  robots.ts  sitemap.ts  rss.xml/route.ts\nlib/\n  validation.ts   # ONE Zod source (contact + comment schemas)\n  github.ts       # cache() + ISR-wrapped GraphQL fetch\n  mongo.ts        # MongoClient (adapter) + Mongoose (models)\n  auth.ts  projects.ts  sendEmail.ts\ncomponents/\n  Galaxy.tsx      # ogl shader galaxy (viewport-gated rAF)\n  GlobeDemo.tsx   # three-globe (dynamic ssr:false, IO-gated)\n  StructuredData.tsx"}]}]}],["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Frontend"," "]}],"Next.js 15 App Router with React 19, server-first rendering, motion/react for animation, and two WebGL scenes (an ogl shader galaxy and a three.js/three-globe globe) code-split as `dynamic(..., { ssr:false })` islands."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Data layer"," "]}],"MongoDB reached through two intentional connections — the native MongoClient promise for the NextAuth adapter and a cached Mongoose connection for the app's own models — plus a server-side `cache()` + ISR wrapper for the GitHub GraphQL feed."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Auth"," "]}],"NextAuth v4 on the database-session strategy with Google + GitHub OAuth; a session callback wires `session.user.id` through so guestbook comments have stable authorship."]}]]}],"$L40","$L41"]}]]}]]}]
3a:["$","section","2",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Performance Engineering: Viewport-Gated WebGL"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"The visual identity leans on two continuously-animating WebGL scenes, and naively they're expensive: a full-screen ogl fragment shader in the hero and a three.js globe with animated arcs further down. Worse, the responsive layout renders a second, CSS-hidden copy of the globe for other breakpoints — which, left alone, spins up a whole extra WebGL context that's never even visible. The performance work was mostly about *not running* GPU work rather than optimizing the shaders themselves."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Code-split"," "]}],"Both scenes load through `next/dynamic` with `ssr:false`, so the shader source and the three.js/three-globe bundle never ship in the server payload or block hydration."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["rAF gating"," "]}],"The galaxy's `requestAnimationFrame` loop is wrapped in start/stop functions driven by an `IntersectionObserver` and `visibilitychange` — scroll it off-screen or switch tabs and the render loop halts completely, with zero visual change when it's back."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Second-context kill"," "]}],"`GlobeDemo` only mounts the actual `<World>` once its container intersects the viewport (with a 200px `rootMargin`); the hidden responsive duplicate never intersects, so its redundant WebGL context is simply never created."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Clean teardown"," "]}],"On unmount the galaxy calls `WEBGL_lose_context` and removes its resize and mouse listeners, so navigating away frees the context instead of leaking it."]}]]}],["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Asset diet"," "]}],"Alongside the render work: the favicon dropped from ~1.6MB to ~2.6KB, raster `<img>` tags were converted to `next/image` now serving AVIF, and the duplicate Google Fonts requests were merged into one — together shaving several MB off the critical path."]}]]}]]}]]}]]}]
3b:["$","section","3",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"SEO & Answer-Engine Optimization"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"I treated discoverability as an engineering surface with three distinct audiences: classic search crawlers, Google's AI surfaces (AI Overviews / Gemini), and standalone answer engines like ChatGPT Search, Perplexity, and Claude. Each one reads the site differently, so each gets an explicit, machine-readable signal rather than being left to infer structure from markup."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Structured data"," "]}],"A server-rendered JSON-LD `@graph` describes a Person, Organization, WebSite, ProfilePage, and SiteNavigationElement set, cross-linked by `@id`, giving machines an explicit entity graph instead of guessing who the site is about."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["AEO allow-list"," "]}],"`robots.ts` explicitly allows the AI crawlers — GPTBot, OAI-SearchBot, ClaudeBot, PerplexityBot, Google-Extended, Applebot-Extended, CCBot and more — so answer engines are permitted to read and *cite* the site rather than being blocked by a blanket rule."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Metadata system"," "]}],"A `metadataBase`, a `%s | MD. Sajjad Hossain` title template, canonical URLs, a structured keyword set, and per-priority sitemap entries; each `/work/[slug]` case study is statically generated with its own `generateMetadata`, article-type OG tags, and canonical."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Dynamic OG"," "]}],"An edge `/api/og` route renders a branded 1200×630 `ImageResponse` from `title`/`subtitle` query params, so every page and project gets a unique, lightweight social card instead of reusing one heavy profile photo."]}]]}]]}]]}]]}]
3c:["$","section","4",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Backend Systems"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"Behind the animation is a genuine backend. MongoDB stores guestbook comments and contact messages, NextAuth handles identity, Nodemailer sends transactional email over Gmail SMTP, and the GitHub GraphQL API feeds the contribution graph. The theme throughout is defensive: nothing should crash the build, leak PII, or let front-end and back-end validation disagree."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Dual DB connections"," "]}],"`lib/mongo.ts` exposes a lazily-built MongoClient promise for the NextAuth `MongoDBAdapter` plus a Mongoose connection cached across HMR — built lazily specifically so a missing `MONGODB_URI` can never throw at module-eval time and take down `next build`."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Guestbook"," "]}],"`/api/comments` requires an authenticated session to POST, supports threaded replies, and uses Mongoose `populate` for author data — including a deliberate `import '@/models/user'` side-effect so the User model is registered and populate actually resolves."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Contact"," "]}],"`/api/messages` validates with the shared Zod schema, enforces a per-IP in-memory rate limit (5 requests / 10 min), HTML-escapes all user text before it enters email markup, and sends both a branded thank-you and an admin notification; the GET handler is gated to the owner's email because it returns stored PII."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["GitHub feed"," "]}],"`lib/github.ts` wraps the GraphQL query in React's `cache()` plus `next: { revalidate: 3600 }`, so the fully-typed `ContributionCalendar` is de-duped per render and cached for an hour instead of hammering the API on every request."]}]]}]]}]]}]]}]
3d:["$","section","5",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Key Decisions"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$undefined","$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["NextAuth v4 database sessions over v5 —"," "]}],"comment authorship depends on a stable `session.user.id` supplied by the MongoDB adapter under the database-session strategy; migrating to v5 would have rewritten that entire path for no user-facing gain, so I stayed on v4 deliberately."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["One Zod schema over per-layer validation —"," "]}],"a single `lib/validation.ts` feeds both the RHF client and the API route, which eliminated a duplicated, subtly-wrong email regex and made front/back drift structurally impossible."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Viewport-gating over 'just lazy-load' —"," "]}],"lazy-importing a WebGL scene still burns GPU the moment it mounts; gating the actual render loop on visibility (and refusing to create the hidden globe's context at all) was the fix that actually helped battery and scroll smoothness."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Dynamic edge OG over a static image —"," "]}],"a tiny `ImageResponse` route gives every page and project a unique branded card and keeps a multi-hundred-KB profile photo out of the social payload entirely."]}]]}],["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Kept styled-components behind an SSR registry over a full rewrite —"," "]}],"rather than porting every styled island to Tailwind, I added a StyledComponentsRegistry to fix FOUC and hydration — pragmatic, visually identical, and far lower risk."]}]]}],["$","li","5",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Strict TypeScript migration over incremental `any` —"," "]}],"I rebuilt the JS app under a strict `tsconfig`, isolating only three genuinely heavy WebGL files behind `@ts-nocheck` so the other ~90 files got real type coverage."]}]]}]]}]]}]]}]
3e:["$","section","6",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"What I Learned"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$undefined","$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Performance is mostly about what you don't run —"," "]}],"the biggest wins came from never creating a second WebGL context and halting the render loop off-screen, not from micro-optimizing shader math."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["AEO is real infrastructure now —"," "]}],"an explicit JSON-LD entity graph plus a deliberate bot allow-list is the difference between being cited by an answer engine and being invisible to it, and it's worth engineering like any other feature."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["A shared validation schema pays for itself instantly —"," "]}],"the first time a field's rules changed, I edited one Zod file and both the form and the API moved together — no drift, no forgotten second copy."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["A strict JS→TS migration surfaces latent bugs —"," "]}],"typing the codebase exposed dead form state and missing null guards that had only ever 'worked' by luck, which is exactly the kind of thing you want a compiler to catch before a user does."]}]]}]]}]]}]]}]
