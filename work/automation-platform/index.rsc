33:["$","div",null,{"className":"mt-10 grid sm:grid-cols-2 gap-4","children":[["$","div","0",{"className":"relative rounded-2xl overflow-hidden border border-white/10 bg-gradient-to-br from-neutral-900 to-neutral-800 p-1.5","children":["$","$L36",null,{"src":"/automation1.png","alt":"Automation Social Media Platform screenshot 1","width":1200,"height":720,"sizes":"(max-width: 640px) 100vw, 50vw","className":"w-full h-56 md:h-64 object-cover rounded-xl","priority":true}]}],["$","div","1",{"className":"relative rounded-2xl overflow-hidden border border-white/10 bg-gradient-to-br from-neutral-900 to-neutral-800 p-1.5","children":["$","$L36",null,{"src":"/automation.png","alt":"Automation Social Media Platform screenshot 2","width":1200,"height":720,"sizes":"(max-width: 640px) 100vw, 50vw","className":"w-full h-56 md:h-64 object-cover rounded-xl","priority":false}]}]]}]
34:["$","div",null,{"className":"mt-8","children":[["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Overview"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[["$","p",null,{"children":"I built a full-stack SaaS platform that collapses Instagram, WhatsApp, and Telegram into a single operational dashboard — one unified inbox, one automation layer, one place to manage every connected account. The hard part was never the UI; it was making three very different messaging APIs behave like one predictable system, delivering webhooks that never double-fire, and running a user-configurable rules engine that can auto-reply, tag, and alert in real time without stepping on itself. Under the hood it's Next.js (App Router) on Vercel, PostgreSQL through Prisma, NextAuth for Google sign-in, and shadcn/ui for a dashboard that stays fast even when a conversation is updating live. This write-up is about the engineering decisions that made \"unify three platforms\" actually reliable rather than a demo that breaks the first time Meta retries a webhook."}],["$","p",null,{"children":"A full-stack automation platform built to streamline social media engagement across Instagram, WhatsApp, and Telegram — intelligent auto-replies, real-time alerts, and secure account access, built to scale."}]]}]]}],["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Key Features"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$","ul",null,{"className":"space-y-3","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Secure Google authentication powered by NextAuth."}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Cross-platform automation for Instagram, WhatsApp, and Telegram."}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Real-time alerts for events like Instagram Reel engagement and activity spikes."}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Modern, accessible UI built with shadcn/ui and responsive layouts."}]]}]]}]}]]}],[["$","section","0",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Why I Built This"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"Small teams and solo operators run their whole customer conversation across Instagram DMs, WhatsApp, and Telegram at once, and every one of those apps is a separate tab, a separate login, and a separate set of missed messages. I kept watching people lose leads simply because a DM sat unanswered for six hours while they were heads-down in WhatsApp. The problem wasn't effort — it was that no single surface showed them everything, and nothing responded on their behalf when they couldn't."}],"$L37"],"$undefined","$undefined"]}]]}],"$L38","$L39","$L3a","$L3b","$L3c","$L3d"],"$L3e"]}]
35:["$","div",null,{"className":"mt-16 border-t border-white/10 pt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6","children":[["$","div",null,{"children":[["$","h3",null,{"className":"text-xl font-semibold text-white","children":"Like what you see?"}],["$","p",null,{"className":"text-neutral-400 text-sm mt-1","children":"Explore more work or get in touch."}]]}],["$","div",null,{"className":"flex items-center gap-3","children":[["$","$L29",null,{"href":"/workspace","className":"inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/15 text-sm text-neutral-200 hover:bg-white/5 transition-colors","children":"More Projects"}],["$","$L29",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-black text-sm font-semibold hover:bg-neutral-200 transition-colors","children":["Get in Touch",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}]
37:["$","p","1",{"children":"So I built the thing I wished existed: one inbox that ingests all three channels, plus an automation layer that answers instantly based on rules the user defines. I specifically wanted it to feel trustworthy — no duplicate auto-replies, no messages silently dropped, no shared login that leaks one client's account to another. That reliability bar is what turned this from a weekend CRUD app into a real systems project."}]
38:["$","section","1",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Architecture Overview"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"The system is a single Next.js App Router application deployed on Vercel, split cleanly into three planes: an auth-gated dashboard, a set of thin webhook/API route handlers, and a domain library where all the real logic lives. Every inbound message from Instagram, WhatsApp, or Telegram is funneled through provider-specific adapters into one normalized Message shape, so the rules engine, the inbox, and the alerting layer never have to know which platform a message came from. PostgreSQL (via Prisma) is the source of truth for accounts, conversations, messages, rules, and the dedupe/outbox tables that keep ingestion honest."}]],["$","div",null,{"className":"rounded-xl border border-white/10 bg-white/[0.02] overflow-x-auto","children":["$","pre",null,{"className":"p-4 text-[12.5px] leading-relaxed font-mono text-neutral-300","children":["$","code",null,{"children":"src/\n  app/\n    (dashboard)/\n      inbox/            # unified live conversation view\n      automations/      # visual rules builder\n      accounts/         # connect / manage channels\n      layout.tsx        # NextAuth-gated shell\n    api/\n      webhooks/\n        meta/route.ts        # IG + WhatsApp (shared Meta HMAC)\n        telegram/route.ts     # secret-token verified\n      auth/[...nextauth]/route.ts\n      realtime/route.ts        # mints scoped pub/sub tokens\n  lib/\n    channels/           # adapters -> normalized Message\n      instagram.ts\n      whatsapp.ts\n      telegram.ts\n    rules/\n      engine.ts         # evaluate(rules, message)\n      conditions.ts     # keyword, first-touch, hours, sender\n      actions.ts        # reply / tag / alert / forward\n    ingest.ts           # persist + dedupe raw events\n    queue.ts            # outbox enqueue + worker dispatch\n    crypto.ts           # provider-token encryption\n    prisma.ts\nprisma/\n  schema.prisma"}]}]}],["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Frontend"," "]}],"Next.js App Router with React Server Components for the initial inbox render, shadcn/ui + Tailwind for the component system, and a thin client subscription that patches conversations live without re-fetching the whole thread."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["API surface"," "]}],"Route handlers stay deliberately dumb — they verify the signature, persist the raw event, and return 200 fast. Every non-trivial decision happens downstream in lib/, which keeps handlers within Vercel's serverless time budget."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],"$L3f"]}],"$L40","$L41"]}]]}]]}]
39:["$","section","2",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Webhook Ingestion & Idempotency"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"Meta, WhatsApp Cloud API, and Telegram all deliver via webhooks, and all three will happily send you the same event more than once — on retry, on redelivery, or when a subscription overlaps. If I processed inline and naively, a single customer message could fire two auto-replies. So the ingestion path is built around one rule: acknowledge fast, dedupe hard, process later."}],["$","p","1",{"children":"Each handler first verifies authenticity — Meta events are validated against the X-Hub-Signature-256 HMAC using the app secret, and Telegram against the secret token header I register with setWebhook. Only then does it write the raw payload and return 200 immediately. The actual work is deferred to an outbox-driven worker so a slow rule evaluation can never blow the serverless timeout and trigger a redelivery storm."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Dedupe key"," "]}],"Every event carries a provider message/update ID; I insert it into a ProcessedEvent table with a UNIQUE constraint. A duplicate insert throws, I catch it, and the event is skipped — the database, not application logic, is the source of truth for 'have I seen this.'"]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Persist-then-process"," "]}],"Raw events land in an OutboxJob row before any business logic runs, so a crash mid-processing loses nothing; the worker picks the job back up on the next tick."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Fast ack"," "]}],"Handlers return 200 in well under a second, which is what keeps Meta and Telegram from marking the endpoint unhealthy and backing off deliveries."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["At-least-once, effectively-once"," "]}],"I assume delivery is at-least-once and lean on the unique constraint + idempotent actions to make the observable result exactly-once, which is the honest way to handle webhooks you don't control."]}]]}]]}]]}]]}]
3a:["$","section","3",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"The Rules Engine & Real-Time Alerts"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"The automation layer is a small rules engine that evaluates a user's rules against the normalized Message and produces actions. Rules are stored as structured JSON in Postgres, so users build them in the dashboard without me shipping code — each rule is an ordered set of conditions (keyword/regex match, first-message-from-sender, outside business hours, sender attributes) and actions (send a templated reply, tag the conversation, forward, or raise an alert). The engine evaluates in priority order and supports both first-match and match-all modes, so a catch-all fallback rule never shadows a specific one."}],["$","p","1",{"children":"Because the same normalized shape feeds the engine regardless of channel, a rule like 'auto-reply with hours + book link on the first WhatsApp message after 6pm' is written once and behaves identically on Instagram or Telegram. When an action is 'alert' — or when a message can't be auto-handled and needs a human — I publish an event to the pub/sub channel scoped to that user, and the dashboard surfaces it live: the inbox reorders, a badge updates, and the operator sees it without refreshing."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Declarative rules"," "]}],"Conditions and actions are data, not code — evaluated by a pure evaluate(rules, message) function that's trivial to unit-test against fixture messages."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Idempotent actions"," "]}],"Auto-reply actions are keyed to the triggering event ID so a replayed webhook can't double-send, closing the loop with the ingestion layer's dedupe."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Scoped realtime"," "]}],"Pub/sub channels are namespaced per user and per account, so a live alert only ever reaches the operator who owns that conversation."]}]]}]]}]]}]]}]
3b:["$","section","4",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Backend Systems"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"The backend is intentionally boring in the good way: a well-normalized relational schema, a single query layer through Prisma, and a strict separation between who-you-are (NextAuth session) and what-you-can-act-on (connected provider accounts). Multi-account access is the load-bearing feature here — a user can connect several Instagram, WhatsApp, and Telegram accounts, and every conversation, message, and rule is foreign-keyed to a specific Account that is in turn owned by a User. That ownership chain is enforced on every read and write, so there's no path where one account's data leaks into another's view."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Relational modeling"," "]}],"User → Account → Conversation → Message as the spine, with Rule, ProcessedEvent, and OutboxJob as supporting tables; Prisma migrations keep the schema versioned and reproducible across environments."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Secure multi-account"," "]}],"Provider access tokens live in their own encrypted column (via lib/crypto), decrypted only at send-time — a leaked session can't hand an attacker the underlying channel credentials."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Query safety"," "]}],"Every Prisma query is scoped by the authenticated user's ID at the boundary, so authorization is a property of the data-access layer rather than something each route has to remember to check."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Outbound sends"," "]}],"Replies fan back out through the same channel adapters that ingested them, so the send path reuses one place per provider for auth, formatting, and error handling."]}]]}]]}]]}]]}]
3c:["$","section","5",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Key Decisions"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$undefined","$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Prisma over raw SQL"," "]}],"The relationship graph (users, accounts, conversations, messages, rules) changes often as features land; Prisma's typed client + migrations caught schema drift at compile time and made the ownership joins readable. I accepted a bit of query overhead in exchange for that safety."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Persist-then-process over inline handling"," "]}],"Doing rule evaluation inside the webhook handler was simpler but fragile — one slow action and Vercel times out and Meta retries. Writing to an outbox and returning 200 immediately decoupled 'received' from 'handled' and killed an entire class of duplicate-delivery bugs."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Database-enforced idempotency over app-level checks"," "]}],"A UNIQUE constraint on the provider event ID is impossible to race; an in-memory 'have I seen this' check isn't, especially across serverless instances. I let Postgres be the arbiter."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["One normalized Message shape over per-channel logic"," "]}],"Adapters absorb every quirk of Instagram, WhatsApp, and Telegram at the edge, so the rules engine, inbox, and alerts are written once. Adding a fourth channel later becomes 'write an adapter,' not 'touch everything.'"]}]]}],["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["JSON rule definitions over hardcoded flows"," "]}],"Users configure automations without a deploy. Rules-as-data made the engine a pure, testable function and turned automation into a product surface instead of a code change."]}]]}],["$","li","5",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Hosted pub/sub over serverless WebSockets"," "]}],"Vercel functions can't hold long-lived connections, so rather than fight the platform I offloaded realtime to a managed pub/sub and minted short-lived scoped tokens — reliable live updates without running my own socket infrastructure."]}]]}]]}]]}]]}]
3d:["$","section","6",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"What I Learned"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$undefined","$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Webhooks are at-least-once, always"," "]}],"You cannot trust an external platform to deliver exactly once. Designing every handler to be safely replayable — and letting the database enforce it — was the single biggest reliability unlock."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Normalize at the edge"," "]}],"Pushing all provider weirdness into thin adapters kept the core of the system clean and made testing dramatically easier, because the whole engine runs on plain fixture objects."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Work with the platform's grain"," "]}],"Fighting Vercel's serverless model on realtime and long-running work was a losing game; leaning into fast-ack + outbox + hosted pub/sub gave me a more robust system with less code to own."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Authorization belongs in the data layer"," "]}],"Scoping every query by owner at the boundary — instead of remembering to check in each route — made multi-account isolation a structural guarantee rather than a discipline I had to maintain by hand."]}]]}]]}]]}]]}]
3e:["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Tech Stack"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$","div",null,{"className":"flex flex-wrap gap-2.5","children":[["$","span","NEXT.JS",{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/[0.04] border border-white/10 text-xs text-neutral-200","children":[["$","img",null,{"src":"/svg/nextjs-icon.svg","alt":"","loading":"lazy","decoding":"async","className":"h-4 w-4 object-contain"}],"NEXT.JS"]}],["$","span","REACT.JS",{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/[0.04] border border-white/10 text-xs text-neutral-200","children":[["$","img",null,{"src":"/svg/react.svg","alt":"","loading":"lazy","decoding":"async","className":"h-4 w-4 object-contain"}],"REACT.JS"]}],["$","span","TAILWIND CSS",{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/[0.04] border border-white/10 text-xs text-neutral-200","children":[["$","img",null,{"src":"/svg/tailwindcss-icon.svg","alt":"","loading":"lazy","decoding":"async","className":"h-4 w-4 object-contain"}],"TAILWIND CSS"]}],["$","span","POSTGRESQL",{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/[0.04] border border-white/10 text-xs text-neutral-200","children":[["$","img",null,{"src":"/svg/postgresql.svg","alt":"","loading":"lazy","decoding":"async","className":"h-4 w-4 object-contain"}],"POSTGRESQL"]}],["$","span","PRISMA",{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/[0.04] border border-white/10 text-xs text-neutral-200","children":[["$","img",null,{"src":"/svg/prisma-icon.svg","alt":"","loading":"lazy","decoding":"async","className":"h-4 w-4 object-contain"}],"PRISMA"]}],["$","span","NODE.JS",{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/[0.04] border border-white/10 text-xs text-neutral-200","children":[["$","img",null,{"src":"/svg/nodejs-icon.svg","alt":"","loading":"lazy","decoding":"async","className":"h-4 w-4 object-contain"}],"NODE.JS"]}],["$","span","SHADCN/UI",{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/[0.04] border border-white/10 text-xs text-neutral-200","children":[["$","img",null,{"src":"/svg/shadcnui.png","alt":"","loading":"lazy","decoding":"async","className":"h-4 w-4 object-contain"}],"SHADCN/UI"]}],["$","span","NEXT AUTH",{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/[0.04] border border-white/10 text-xs text-neutral-200","children":[["$","img",null,{"src":"/svg/nextauth.png","alt":"","loading":"lazy","decoding":"async","className":"h-4 w-4 object-contain"}],"NEXT AUTH"]}],["$","span","VERCEL",{"className":"inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/[0.04] border border-white/10 text-xs text-neutral-200","children":[["$","img",null,{"src":"/svg/vercel-icon.svg","alt":"","loading":"lazy","decoding":"async","className":"h-4 w-4 object-contain"}],"VERCEL"]}]]}]}]]}]
3f:["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Data layer"," "]}],"PostgreSQL through Prisma, with the schema modeling User → Account → Conversation → Message plus Rule, ProcessedEvent (idempotency), and OutboxJob tables."]}]
40:["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Auth"," "]}],"NextAuth with the Google provider for human login to the dashboard; per-channel provider tokens (Meta/Telegram) are stored separately and encrypted at rest, never mixed with the session layer."]}]]}]
41:["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Realtime"," "]}],"A hosted pub/sub service carries live inbox and alert events, because Vercel serverless functions can't hold persistent socket connections — the app mints short-lived, channel-scoped subscription tokens per user."]}]]}]
