2f:["$","div",null,{"className":"mt-10 grid sm:grid-cols-2 gap-4","children":[["$","div","0",{"className":"relative rounded-2xl overflow-hidden border border-white/10 bg-gradient-to-br from-neutral-900 to-neutral-800 p-1.5","children":["$","$L32",null,{"src":"/planit.png","alt":"Planit screenshot 1","width":1200,"height":720,"sizes":"(max-width: 640px) 100vw, 50vw","className":"w-full h-56 md:h-64 object-cover rounded-xl","priority":true}]}],["$","div","1",{"className":"relative rounded-2xl overflow-hidden border border-white/10 bg-gradient-to-br from-neutral-900 to-neutral-800 p-1.5","children":["$","$L32",null,{"src":"/planit.png","alt":"Planit screenshot 2","width":1200,"height":720,"sizes":"(max-width: 640px) 100vw, 50vw","className":"w-full h-56 md:h-64 object-cover rounded-xl","priority":false}]}]]}]
30:["$","div",null,{"className":"mt-8","children":[["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Overview"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[["$","p",null,{"children":"Planit is a task manager I built to be fast, personal, and deliberately opinionated — the anti-Jira. Every user signs in with Google and lands on a dashboard scoped entirely to them, where work is organized by priority and by custom categories they define themselves. Under the hood it's a React + Tailwind front end talking to an Express/MongoDB API that runs as a serverless function on Vercel, wrapped in an optimistic UI that makes every click feel instant even when the network isn't. I designed the whole thing around one principle: the app should never make you wait to think."}],["$","p",null,{"children":"A modern, full-stack task management platform designed to help you plan smarter, stay organized, and boost productivity — a clean UI, smooth interactions, and secure authentication for a seamless daily workflow."}]]}]]}],["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Key Features"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$","ul",null,{"className":"space-y-3","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Secure Google authentication with a personalized dashboard."}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Create, manage, and track tasks with real-time MongoDB persistence."}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Smart task organization with priorities and custom categories."}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Clean, intuitive UI with smooth animations for a focused experience."}]]}],["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Fast performance and responsive layouts designed for productivity."}]]}]]}]}]]}],[["$","section","0",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Why I Built This"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"I've bounced off nearly every 'powerful' task manager I've tried. They optimize for configurability — statuses, workflows, custom fields, automations — and in doing so they optimize away momentum. By the time I've set up the perfect board, I've lost the thing I actually wanted to do. Planit is my reaction to that: a tool with a small number of strong opinions and almost nothing to configure, so the fastest path is always just capturing the task and moving on."}],"$L33"],"$undefined","$undefined"]}]]}],"$L34","$L35","$L36","$L37","$L38","$L39"],"$L3a"]}]
31:["$","div",null,{"className":"mt-16 border-t border-white/10 pt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6","children":[["$","div",null,{"children":[["$","h3",null,{"className":"text-xl font-semibold text-white","children":"Like what you see?"}],["$","p",null,{"className":"text-neutral-400 text-sm mt-1","children":"Explore more work or get in touch."}]]}],["$","div",null,{"className":"flex items-center gap-3","children":[["$","$L29",null,{"href":"/workspace","className":"inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/15 text-sm text-neutral-200 hover:bg-white/5 transition-colors","children":"More Projects"}],["$","$L29",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-black text-sm font-semibold hover:bg-neutral-200 transition-colors","children":["Get in Touch",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}]
33:["$","p","1",{"children":"I also wanted a project where I owned every layer of a real full-stack app end to end — Google auth, the data model, the serverless deployment, and especially perceived performance. A task app is deceptively good for this, because users interact with it constantly and notice any latency immediately. That made it the perfect place to get obsessive about optimistic updates and a data model that stays fast as it grows."}]
34:["$","section","1",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Architecture Overview"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"Planit is split into a React SPA and a stateless Express API, both deployed on Vercel. The client is a Vite build served as static assets; the API is the same Express app exported as a single serverless handler behind a catch-all rewrite. Auth is Google-first: the browser gets a Google ID token, the server verifies it and issues its own httpOnly session cookie, and every data query is scoped by the authenticated user's id so the dashboard is personal by construction."}]],["$","div",null,{"className":"rounded-xl border border-white/10 bg-white/[0.02] overflow-x-auto","children":["$","pre",null,{"className":"p-4 text-[12.5px] leading-relaxed font-mono text-neutral-300","children":["$","code",null,{"children":"planit/\n├── client/                      # React + Vite + Tailwind\n│   ├── src/\n│   │   ├── components/          # TaskCard, PriorityFlag, CategoryPill\n│   │   ├── features/tasks/      # useTasks(), optimistic mutations\n│   │   ├── context/AuthContext.jsx\n│   │   └── lib/api.js           # fetch wrapper, credentials: 'include'\n│   └── vite.config.js\n├── server/\n│   ├── api/index.js             # Express app, exported as serverless handler\n│   ├── models/                  # Task.js, Category.js, User.js  (Mongoose)\n│   ├── routes/                  # tasks.js, categories.js, auth.js\n│   ├── middleware/auth.js       # verifies session cookie -> req.user\n│   └── db.js                    # cached Mongo connection (serverless-safe)\n└── vercel.json                  # rewrites /api/* -> serverless function"}]}]}],["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Frontend —"," "]}],"React + Vite + Tailwind, with TanStack Query owning all server state so caching, refetching, and optimistic mutations live in one place instead of scattered useEffect hooks."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Data layer —"," "]}],"MongoDB via Mongoose, with Task, Category, and User collections. Every task carries a userId and a categoryId; queries filter on userId first, always."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Auth —"," "]}],"Google Identity Services on the client, google-auth-library verifying the ID token server-side, then a signed httpOnly JWT cookie for the session."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Deployment —"," "]}],"One Vercel project: static client build plus the Express API as a serverless function, with a cached Mongo connection so warm invocations skip the handshake."]}]]}]]}]]}]]}]
35:["$","section","2",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Task Engine — Priorities & Categories"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"The core of Planit is a small task engine that keeps the dashboard sorted the way I actually think about work. Priority is a four-value enum (low, medium, high, urgent), but each level maps to a numeric weight so I can sort deterministically on the server. The default ordering is a composite: priority weight descending, then due date ascending, then creation time — so the most urgent, soonest-due work always floats to the top without the user touching a sort control."}],["$","p","1",{"children":"Categories are the one place I let users customize. Each category is a user-owned document with a name and a color, and tasks reference it by id rather than duplicating the label. That keeps renames and recolors a single write instead of a fan-out across every task, and it lets the sidebar render category filters straight from the Category collection."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Deterministic sort —"," "]}],"Priority stored as an enum for the API but weighted numerically for ordering, so the same composite sort runs identically on the server and in the optimistic client cache."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Referenced categories —"," "]}],"Tasks hold a categoryId, not a copied label; a rename is one document update, and category colors drive the CategoryPill component directly."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Compound index —"," "]}],"A { userId: 1, category: 1, priority: -1 } index backs the dashboard's most common query — 'my tasks in this category, most important first' — so it stays an index scan as data grows."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Filtered views —"," "]}],"Category and priority filters compose into a single Mongo query rather than filtering client-side, keeping the payload small on larger accounts."]}]]}]]}]]}]]}]
36:["$","section","3",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Optimistic UI Layer"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"Nothing in Planit shows a spinner for a task action. Creating, completing, editing, and deleting all apply to the local cache immediately and reconcile with the server afterward. I built this on TanStack Query's mutation lifecycle: onMutate cancels in-flight refetches, snapshots the current cache, and writes the optimistic change; onError rolls back to that snapshot; onSettled invalidates so the server's truth wins in the end."}],["$","p","1",{"children":"The interesting edge case was creates. A new task has no server id yet, so I assign a temporary client id, render it instantly, and swap in the real id once the POST resolves — while making sure a fast follow-up action (like immediately completing that new task) queues correctly against the temp id. Getting that reconciliation right is what makes the app feel native rather than like a webpage waiting on a database."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Snapshot + rollback —"," "]}],"Every mutation captures the pre-change cache so a failed request restores the exact prior state instead of a jarring refetch flash."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Temp-id reconciliation —"," "]}],"Optimistic creates render with a client-generated id and swap to the server id on resolve, so subsequent actions don't target a ghost."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Motion on change —"," "]}],"Framer Motion's layout animations and AnimatePresence handle reordering, filtering, and removal, so the optimistic state change and the animation are driven by the same source of truth."]}]]}]]}]]}]]}]
37:["$","section","4",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Backend Systems"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"The API is a conventional REST surface — /tasks, /categories, /auth — kept intentionally thin because the client already owns most of the UX state. The work on the backend is in three places: verifying identity, scoping data, and surviving serverless cold starts. Auth middleware reads the session cookie, verifies the JWT, and hangs req.user off the request; from there every handler filters by req.user.id, so there's no way to read another user's tasks even with a guessed id."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Auth —"," "]}],"Google ID token verified once at login with google-auth-library, then the app issues its own httpOnly, SameSite JWT cookie so I never handle passwords and every request carries a cheap-to-verify session."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Data access —"," "]}],"Mongoose models with validation on priority enums and required userId, plus indexes tuned to the dashboard query rather than left to Mongo's defaults."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["API —"," "]}],"REST routes with a shared error handler that maps validation and auth failures to clean status codes, so the client's onError rollbacks trigger predictably."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Serverless connection —"," "]}],"The Mongo connection is cached on the module scope and reused across warm invocations, avoiding a new handshake (and connection-pool exhaustion) on every request."]}]]}]]}]]}]]}]
38:["$","section","5",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Key Decisions"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$undefined","$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["MongoDB over Postgres —"," "]}],"Tasks and user-defined categories are naturally document-shaped and I wanted to iterate on the schema fast. There are no heavy relational joins in the hot path, so a document store fit the access pattern better than SQL."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Google-only auth over email/password —"," "]}],"Skipping passwords removed a whole class of security burden (hashing, resets, breaches) and cut onboarding to one click. The trade-off — requiring a Google account — is acceptable for the audience I built this for."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Optimistic UI over spinners —"," "]}],"For an app people touch dozens of times a session, perceived latency matters more than architectural simplicity. I accepted the added complexity of rollbacks and temp-id reconciliation to make every action feel instant."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Express-on-Vercel over a separate host —"," "]}],"Running the API as a serverless function keeps deployment to a single project and one CI pipeline. The cost was solving connection caching so cold starts and warm reuse both behave — a real gotcha I'd have avoided on a long-lived server."]}]]}],["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Referenced categories over denormalized labels —"," "]}],"Storing a categoryId instead of copying the label onto every task means renames and color changes are one write. It costs a small lookup to hydrate category metadata, which I do once per dashboard load."]}]]}],["$","li","5",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Opinionated UX over configurability —"," "]}],"I deliberately shipped fewer options — one sort, a fixed priority scale, minimal settings. That cut UI surface and edge cases dramatically and kept the product true to its point."]}]]}]]}]]}]]}]
39:["$","section","6",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"What I Learned"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$undefined","$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Serverless changes your data layer —"," "]}],"The single biggest lesson was that Express in a serverless function is not Express on a server: without a cached Mongo connection you exhaust the pool fast. Getting that right taught me more about connection lifecycles than any long-running app would have."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Optimism is mostly about failure —"," "]}],"The happy path of optimistic UI is trivial; the value is entirely in getting rollback and temp-id reconciliation right, which is where I spent most of the effort and learned the most."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Constraints are a feature —"," "]}],"Choosing to make the app opinionated didn't just improve the product — it shrank the code, killed whole categories of edge cases, and made decisions faster for me as the developer."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Index for the query you actually run —"," "]}],"Watching the dashboard query and building a compound index around it, instead of trusting defaults, was a small change with an outsized effect on how the app scales per user."]}]]}]]}]]}]]}]
