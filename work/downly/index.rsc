33:["$","div",null,{"className":"mt-10 grid sm:grid-cols-2 gap-4","children":[["$","div","0",{"className":"relative rounded-2xl overflow-hidden border border-white/10 bg-gradient-to-br from-neutral-900 to-neutral-800 p-1.5","children":["$","$L36",null,{"src":"/downly.png","alt":"Downly screenshot 1","width":1200,"height":720,"sizes":"(max-width: 640px) 100vw, 50vw","className":"w-full h-56 md:h-64 object-cover rounded-xl","priority":true}]}],["$","div","1",{"className":"relative rounded-2xl overflow-hidden border border-white/10 bg-gradient-to-br from-neutral-900 to-neutral-800 p-1.5","children":["$","$L36",null,{"src":"/downly2.png","alt":"Downly screenshot 2","width":1200,"height":720,"sizes":"(max-width: 640px) 100vw, 50vw","className":"w-full h-56 md:h-64 object-cover rounded-xl","priority":false}]}]]}]
34:["$","div",null,{"className":"mt-8","children":[["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Overview"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[["$","p",null,{"children":"Downly is a Next.js 16 web app that turns a public Instagram link into a real file download — reels, photo and video posts, IGTV, multi-item carousels and stories. There is no account, no browser extension and no credential handling: it only ever touches content a logged-out visitor can already see. Extraction runs server-side through a chain of interchangeable providers tried in priority order, and every media URL the client receives is a signed, expiring link to the app's own /api/media proxy rather than an Instagram CDN address. Layered on top is the product work — in-browser MP3 extraction, carousel ZIP bundling, resolution picking, an installable PWA that registers itself in the OS share sheet, and 13 fully pre-rendered locales including right-to-left Arabic. It runs on React 19 with strict TypeScript, Tailwind v4, shadcn/ui and next-intl, and is deployed on Vercel at downly.localhost:5000."}],["$","p",null,{"children":"A production Instagram downloader for public reels, posts, stories and carousels — media is extracted server-side through a swappable provider chain, and the browser only ever receives signed, expiring, same-origin links, so a raw CDN URL never reaches the client."}]]}]]}],["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Key Features"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$","ul",null,{"className":"space-y-3","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Downloads public reels, posts, IGTV, stories and multi-item carousels in original quality."}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Real file downloads through a signed, expiring, same-origin streaming proxy — never a raw CDN link."}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"In-browser MP3 extraction and carousel ZIP bundling, with no server-side transcoding."}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Swappable extraction: providers are tried in priority order and can be replaced without touching the API or UI."}]]}],["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"13 locales with right-to-left Arabic, every language tree pre-rendered at build time."}]]}],"$L37"]}]}]]}],["$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f"],"$L40"]}]
