l":"http://localhost:5000","name":"MD. Sajjad Hossain Portfolio","alternateName":"MD. Sajjad Hossain","description":"Portfolio of MD. Sajjad Hossain — Full Stack Developer building modern, scalable web applications.","publisher":{"@id":"http://localhost:5000/#person"},"inLanguage":"en-US"},{"@type":"ProfilePage","@id":"http://localhost:5000/#webpage","url":"http://localhost:5000","name":"MD. Sajjad Hossain | Full Stack Developer","isPartOf":{"@id":"http://localhost:5000/#website"},"about":{"@id":"http://localhost:5000/#person"},"mainEntity":{"@id":"http://localhost:5000/#person"},"inLanguage":"en-US"},{"@type":"SiteNavigationElement","position":1,"name":"Home","description":"Portfolio overview, skills and highlights of MD. Sajjad Hossain — a Full Stack Developer specializing in Next.js, React, TypeScript and MongoDB.","url":"http://localhost:5000"},{"@type":"SiteNavigationElement","position":2,"name":"About","description":"About MD. Sajjad Hossain — a Full Stack Developer, freelancer and problem solver: background, journey and work experience.","url":"http://localhost:5000/about"},{"@type":"SiteNavigationElement","position":3,"name":"Workspace","description":"Real-world projects, dashboards and automation systems built by MD. Sajjad Hossain with Next.js, React and modern web tech.","url":"http://localhost:5000/workspace"},{"@type":"SiteNavigationElement","position":4,"name":"Contact","description":"Get in touch with MD. Sajjad Hossain for freelance work, collaborations or full-time opportunities.","url":"http://localhost:5000/contact"},{"@type":"SiteNavigationElement","position":5,"name":"Book a Call","description":"Schedule a call with MD. Sajjad Hossain to discuss your project.","url":"http://localhost:5000/bookCall"},{"@type":"SiteNavigationElement","position":6,"name":"Guestbook","description":"Sign the guestbook and share your thoughts with MD. Sajjad Hossain.","url":"http://localhost:5000/guestBook"},{"@type":"SiteNavigationElement","position":7,"name":"Links","description":"All social and professional links for MD. Sajjad Hossain — GitHub, LinkedIn, Instagram and more.","url":"http://localhost:5000/links"},{"@type":"CreativeWork","@id":"http://localhost:5000/work/personal-portfolio#project","name":"Personal Portfolio","url":"http://localhost:5000/work/personal-portfolio","description":"A developer-first, full-stack portfolio that combines refined UI/UX, smooth animations, and practical utility into a high-performance digital presence, optimized for SEO and accessibility.","creator":{"@id":"http://localhost:5000/#person"},"keywords":"NEXT.JS, REACT.JS, TAILWIND CSS, MONGODB, NODE.JS, MOTION.DEV, NEXT AUTH, NODE MAILER, VERCEL, SEO","sameAs":"http://localhost:5000"},{"@type":"CreativeWork","@id":"http://localhost:5000/work/nextype#project","name":"NexType","url":"http://localhost:5000/work/nextype","description":"A browser typing-speed test that measures WPM and accuracy in real time, plays a genuine mechanical keyboard sound, and lets you race friends live — with cloud-synced settings, streaks, a weak-key heatmap and a global leaderboard once you sign in.","creator":{"@id":"http://localhost:5000/#person"},"keywords":"NEXT.JS, REACT.JS, TYPESCRIPT, TAILWIND CSS, MOTION.DEV, AUTH.JS, VERCEL","sameAs":"https://nextype.localhost:5000"},{"@type":"CreativeWork","@id":"http://localhost:5000/work/downly#project","name":"Downly","url":"http://localhost:5000/work/downly","description":"A production Instagram downloader for public reels, posts, stories and carousels — media is extracted server-side through a swappable provider chain, and the browser only ever receives signed, expiring, same-origin links, so a raw CDN URL never reaches the client.","creator":{"@id":"http://localhost:5000/#person"},"keywords":"NEXT.JS, REACT.JS, TYPESCRIPT, TAILWIND CSS, SHADCN/UI, MOTION.DEV, NODE.JS, VERCEL, SEO","sameAs":"https://downly.localhost:5000/en"},{"@type":"CreativeWork","@id":"http://localhost:5000/work/glasswind#project","name":"Glasswind","url":"http://localhost:5000/work/glasswind","description":"A frosted-glass React component library — 21 accessible, GPU-animated glassmorphism components (buttons, modals, forms, overlays) plus 6 hooks, published to npm as a zero-runtime-dependency, tree-shakeable package that any React or Next.js app can install and import.","creator":{"@id":"http://localhost:5000/#person"},"keywords":"TYPESCRIPT, REACT.JS, CSS3, VITE, NPM, VERCEL","sameAs":"https://glasswind.vercel.app"},{"@type":"CreativeWork","@id":"http://localhost:5000/work/automation-platform#project","name":"Automation Social Media Platform","url":"http://localhost:5000/work/automation-platform","description":"A full-stack automation platform built to streamline social media engagement across Instagram, WhatsApp, and Telegram — intelligent auto-replies, real-time alerts, and secure account access, built to scale.","creator":{"@id":"http://localhost:5000/#person"},"keywords":"NEXT.JS, REACT.JS, TAILWIND CSS, POSTGRESQL, PRISMA, NODE.JS, SHADCN/UI, NEXT AUTH, VERCEL"},{"@type":"CreativeWork","@id":"http://localhost:5000/work/facebook-campaign-analyzer#project","name":"Facebook Campaign Analyzer","url":"http://localhost:5000/work/facebook-campaign-analyzer","description":"A full-stack Facebook ads management platform inspired by Meta Ads Manager — create, manage, and optimize campaigns, ad sets, and ads with image and video creatives through a secure, scalable interface.","creator":{"@id":"http://localhost:5000/#person"},"keywords":"NEXT.JS, REACT.JS, TAILWIND CSS, POSTGRESQL, PRISMA, NODE.JS, MATERIAL UI, ANT DESIGN, APEXCHARTS"},{"@type":"CreativeWork","@id":"http://localhost:5000/work/employee-management-system#project","name":"Employee Management System","url":"http://localhost:5000/work/employee-management-system","description":"A full-stack, role-based employee management platform designed to handle multi-level access, task assignments, and secure data separation across teams through a structured, scalable dashboard system.","creator":{"@id":"http://localhost:5000/#person"},"keywords":"REACT.JS, TAILWIND CSS, MONGODB, EXPRESS, NODE.JS, MATERIAL UI"},{"@type":"CreativeWork","@id":"http://localhost:5000/work/chat-application#project","name":"Chat Application","url":"http://localhost:5000/work/chat-application","description":"A modern, full-stack chat application built for real-time communication with secure authentication, responsive design, and a smooth, user-friendly messaging experience.","creator":{"@id":"http://localhost:5000/#person"},"keywords":"REACT.JS, TAILWIND CSS, MATERIAL UI, REDUX, SOCKET.IO, NODE.JS, EXPRESS.JS, MONGODB, WEBHOOKS"},{"@type":"CreativeWork","@id":"http://localhost:5000/work/planit#project","name":"Planit","url":"http://localhost:5000/work/planit","description":"A modern, full-stack task management platform designed to help you plan smarter, stay organized, and boost productivity — a clean UI, smooth interactions, and secure authentication for a seamless daily workflow.","creator":{"@id":"http://localhost:5000/#person"},"keywords":"REACT.JS, TAILWIND CSS, MONGODB, EXPRESS, NODE.JS, VERCEL"}]}0:{"P":null,"c":["","work","facebook-campaign-analyzer"],"q":"","i":false,"f":[[["",{"children":["work",{"children":[["slug","facebook-campaign-analyzer","d",null],{"children":["__PAGE__",{}]}]}]},"$undefined","$undefined",20],[["$","$L1",null,{"loading":[["$","$L2","l",{}],[],[]],"children":["$","$3","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/16b937c4d2d7132f.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","link","1",{"rel":"stylesheet","href":"/_next/static/css/2d0abfabb6fa2bd9.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"en","children":[["$","head",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$4"}}],"$L5","$L6","$L7","$L8","$L9"]}],"$La"]}]]}]}],{"children":["$Lb