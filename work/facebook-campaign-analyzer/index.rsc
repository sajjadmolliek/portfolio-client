32:["$","div",null,{"className":"mt-10 grid sm:grid-cols-2 gap-4","children":[["$","div","0",{"className":"relative rounded-2xl overflow-hidden border border-white/10 bg-gradient-to-br from-neutral-900 to-neutral-800 p-1.5","children":["$","$L35",null,{"src":"/fb.png","alt":"Facebook Campaign Analyzer screenshot 1","width":1200,"height":720,"sizes":"(max-width: 640px) 100vw, 50vw","className":"w-full h-56 md:h-64 object-cover rounded-xl","priority":true}]}],["$","div","1",{"className":"relative rounded-2xl overflow-hidden border border-white/10 bg-gradient-to-br from-neutral-900 to-neutral-800 p-1.5","children":["$","$L35",null,{"src":"/fb.png","alt":"Facebook Campaign Analyzer screenshot 2","width":1200,"height":720,"sizes":"(max-width: 640px) 100vw, 50vw","className":"w-full h-56 md:h-64 object-cover rounded-xl","priority":false}]}]]}]
33:["$","div",null,{"className":"mt-8","children":[["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Overview"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[["$","p",null,{"children":"Facebook Campaign Analyzer is a self-hosted Meta Ads Manager alternative I built to create, manage, and optimize the full campaign -> ad set -> ad hierarchy without living inside Meta's own UI. It talks directly to the Meta Marketing API to sync objects in both directions, uploads image and video creatives, and renders live performance insights — spend, CTR, CPC, ROAS — as interactive ApexCharts time series. Under the hood it's a Next.js App Router app backed by PostgreSQL and Prisma, with a delta-sync engine and a rate-limit-aware Graph API client doing the heavy lifting. The goal was a tool where a media buyer can drill from a whole account down to a single ad and trust that the numbers on screen match what Meta actually reports."}],["$","p",null,{"children":"A full-stack Facebook ads management platform inspired by Meta Ads Manager — create, manage, and optimize campaigns, ad sets, and ads with image and video creatives through a secure, scalable interface."}]]}]]}],["$","section",null,{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Key Features"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$","ul",null,{"className":"space-y-3","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Create and manage Facebook campaigns, ad sets, and ads in a structured workflow."}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Run image and video ads across placements using the Meta Business API."}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Secure authentication with NextAuth for protected campaign access."}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Real-time campaign insights and status tracking for ads and ad sets."}]]}],["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":"Modern, responsive dashboard UI built for performance and usability."}]]}]]}]}]]}],[["$","section","0",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Why I Built This"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[["$L36","$L37"],"$undefined","$undefined"]}]]}],"$L38","$L39","$L3a","$L3b","$L3c","$L3d"],"$L3e"]}]
34:["$","div",null,{"className":"mt-16 border-t border-white/10 pt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6","children":[["$","div",null,{"children":[["$","h3",null,{"className":"text-xl font-semibold text-white","children":"Like what you see?"}],["$","p",null,{"className":"text-neutral-400 text-sm mt-1","children":"Explore more work or get in touch."}]]}],["$","div",null,{"className":"flex items-center gap-3","children":[["$","$L29",null,{"href":"/workspace","className":"inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/15 text-sm text-neutral-200 hover:bg-white/5 transition-colors","children":"More Projects"}],["$","$L29",null,{"href":"/contact","className":"inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-black text-sm font-semibold hover:bg-neutral-200 transition-colors","children":["Get in Touch",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}]
36:["$","p","0",{"children":"Meta's Ads Manager is powerful but slow to navigate, and it hides the campaign -> ad set -> ad hierarchy behind endless tabs and modals. I wanted a single surface where I could see every level of an account at once, edit budgets and statuses inline, and watch performance charts update without a dozen clicks. Existing third-party dashboards were either read-only reporting tools or expensive SaaS with their own opinions, so I built the thing I actually wanted to use."}]
37:["$","p","1",{"children":"It was also the perfect excuse to work end-to-end against a genuinely hard external API. The Meta Marketing API is asynchronous in places, aggressively rate-limited, and eventually consistent — building a tool that stays in sync with it forced me to think carefully about reconciliation, background jobs, and idempotency rather than just wiring up CRUD to a friendly REST endpoint."}]
38:["$","section","1",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Architecture Overview"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"The app is a Next.js App Router monolith: server components and Route Handlers for anything that touches Meta, client components for the interactive tables and charts. All persistent state lives in PostgreSQL through Prisma, and the expensive Meta work — full syncs and async insight report polling — is pushed onto background workers so request handlers stay fast and never block on a rate-limited Graph API call."}]],["$","div",null,{"className":"rounded-xl border border-white/10 bg-white/[0.02] overflow-x-auto","children":["$","pre",null,{"className":"p-4 text-[12.5px] leading-relaxed font-mono text-neutral-300","children":["$","code",null,{"children":"facebook-campaign-analyzer/\n├─ app/                       # Next.js App Router\n│  ├─ (dashboard)/\n│  │  ├─ campaigns/[id]/      # campaign → ad set → ad drill-down\n│  │  ├─ insights/            # ApexCharts reporting views\n│  │  └─ creatives/           # image + video upload manager\n│  ├─ api/\n│  │  ├─ meta/sync/           # pull/push sync endpoints\n│  │  ├─ meta/webhooks/       # Meta change notifications\n│  │  └─ insights/[level]/    # aggregated metrics API\n├─ lib/\n│  ├─ meta/                   # Graph API client + guards\n│  │  ├─ client.ts\n│  │  ├─ insights.ts          # async report jobs + polling\n│  │  └─ ratelimit.ts         # BUC header parsing + backoff\n│  ├─ sync/                   # delta-sync engine, upsert reconcilers\n│  └─ auth.ts                 # NextAuth config\n├─ prisma/\n│  └─ schema.prisma           # AdAccount→Campaign→AdSet→Ad→Creative\n└─ workers/                   # background sync + insight pollers"}]}]}],["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Frontend"," "]}],"React server/client components with Tailwind for layout, Material UI for data-dense tables and forms, and Ant Design for the campaign tree and complex pickers; ApexCharts handles all time-series reporting."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Data layer"," "]}],"PostgreSQL via Prisma, with the schema mirroring Meta's object tree one-to-one and a separate normalized metrics table for insight history."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Meta layer"," "]}],"A single typed Graph API client wraps every call with token injection, BUC rate-limit accounting, and retry/backoff, so no feature code talks to Meta raw."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],"$L3f"]}],"$L40"]}]]}]]}]
39:["$","section","2",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Modeling the Ad Hierarchy & the Sync Engine"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"Meta's object model is a strict tree — an Ad Account owns Campaigns, each Campaign owns Ad Sets, each Ad Set owns Ads, and each Ad points at a Creative — and I mirrored that exactly in Prisma rather than flattening it into a generic 'objects' table. Every row carries both my internal cuid and the immutable Meta object ID, plus a syncedAt timestamp and a syncStatus enum, so I can always reconcile local state against what Meta currently reports. Budgets are a subtle case: they live at either the campaign or the ad-set level depending on whether Campaign Budget Optimization is on, so I modeled budget fields as nullable at both levels and enforced the 'exactly one' rule in application code."}],["$","p","1",{"children":"The sync engine is the backbone of the whole app, because everything downstream assumes local Postgres is a faithful mirror of Meta. Rather than re-crawling entire accounts, it pages the Graph API filtered by updated_time since the last successful cursor, so a routine refresh touches dozens of changed objects instead of thousands."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Bi-directional sync"," "]}],"Pull reconciles Meta -> Postgres via idempotent upserts keyed on the Meta object ID; push translates local edits into Graph API mutations and reverts the optimistic UI if Meta rejects the change."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Delta over full crawl"," "]}],"Each sync stores a per-account cursor and only fetches objects with an updated_time newer than the last run, keeping refreshes cheap and rate-limit-friendly."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Rate-limit guard"," "]}],"A wrapper parses Meta's X-Business-Use-Case-Usage headers and throttles per ad account before hitting the ceiling, since Meta's limits are per-business-use-case, not per-endpoint."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Soft archival"," "]}],"Meta never truly deletes objects — they move to ARCHIVED/DELETED — so sync flags rows inactive instead of dropping them, which preserves historical insight rows that still reference them."]}]]}]]}]]}]]}]
3a:["$","section","3",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Real-Time Insights with ApexCharts"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"Insights are the reason the tool exists, so the reporting layer had to feel live. The Marketing API won't return large insight sets synchronously — you POST an async report job, get back a report_run_id, and poll until it's ready — so I built a small job runner that kicks off report jobs, polls them with backoff, and writes normalized metric rows into a time-series table keyed by (object, level, date, breakdown)."}],["$","p","1",{"children":"On the frontend, ApexCharts renders spend, impressions, CTR, CPC, and ROAS as brushable area and line charts with tooltips synced across the campaign, ad-set, and ad levels. I use SWR to revalidate on an interval and on window focus so a chart reflects the latest completed sync without a manual refresh, and I downsample server-side so the browser never parses more than a few hundred points per series even on wide date ranges."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Async report jobs"," "]}],"Every insight pull goes through Meta's async endpoint (report_run_id + poll), which sidesteps the synchronous endpoint's tighter limits and timeouts on larger accounts."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Server-side aggregation"," "]}],"SQL rolls raw metric rows up to hourly and daily granularity so ApexCharts receives pre-shaped series instead of aggregating thousands of rows in the client."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Derived metrics at query time"," "]}],"CTR, CPC, CPM, and ROAS are computed from the base fields (impressions, clicks, spend, action values) at read time, so metric definitions stay consistent everywhere they appear."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Synced multi-level tooltips"," "]}],"Hovering a date on the campaign chart highlights the same point across the ad-set and ad breakdown charts, so the drill-down reads as one coherent view."]}]]}]]}]]}]]}]
3b:["$","section","4",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Backend Systems"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":[[["$","p","0",{"children":"The backend is Next.js Route Handlers over Prisma and PostgreSQL, with the heavy Meta work deliberately pushed onto background workers so user-facing requests stay snappy. The API is organized around the same hierarchy the UI navigates, which keeps data fetching predictable at every level."}]],"$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Auth & tokens"," "]}],"NextAuth with Facebook OAuth handles login and yields the user token, which I exchange for a longer-lived token; tokens are encrypted at rest and refreshed proactively before expiry so syncs never fail mid-run on an expired credential."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Data layer"," "]}],"The Prisma schema mirrors the Meta tree with composite indexes on (adAccountId, metaId) for reconciliation and (objectId, date) for fast insight range scans."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Creative uploads"," "]}],"Images are hashed and pushed to Meta's /adimages endpoint, which returns an image_hash I persist; videos go to /advideos as an async upload, so I poll the video's processing status and generate a local thumbnail before it can be attached to an ad."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["API design"," "]}],"Insight and object endpoints are namespaced by level (/api/insights/campaign, /adset, /ad), so each dashboard view maps to one predictable handler with the right aggregation baked in."]}]]}],["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Background workers"," "]}],"Sync reconciliation and insight polling run off the request path and write back to Postgres, which is what lets the UI show fresh data without ever waiting on a slow, rate-limited Graph API call inline."]}]]}]]}]]}]]}]
3c:["$","section","5",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"Key Decisions"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$undefined","$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Mirror Meta's IDs, don't invent my own"," "]}],"Every object stores its Meta object ID as the sync key, which makes upserts idempotent and reconciliation between local state and Meta trivial instead of a fuzzy matching problem."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Prisma over raw SQL"," "]}],"The hierarchy is relation-heavy and I wanted typed joins across five tables; I only drop to raw SQL for the heavy insight aggregations that need window functions and date bucketing."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Postgres over a dedicated time-series DB"," "]}],"Per-account insight volume is modest, so a well-indexed metrics table with date-range scans beat the operational cost of running and syncing a separate TSDB."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Async insight jobs, always"," "]}],"Even for small pulls I use Meta's async report endpoint rather than the synchronous one, trading a little latency for far more headroom against rate limits and timeouts."]}]]}],["$","li","4",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Three UI kits, scoped by strength"," "]}],"Rather than force one library into every role, I use Material UI for dense tables and forms, Ant Design for the campaign tree and pickers, and Tailwind for layout and one-offs — accepting a heavier bundle in exchange for building each surface with the tool that fit it best."]}]]}],["$","li","5",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Optimistic UI with server reconciliation"," "]}],"Edits apply instantly in the UI and reconcile against Meta's actual response, reverting if rejected, because Graph API round-trips are too slow to block the user on."]}]]}]]}]]}]]}]
3d:["$","section","6",{"className":"grid md:grid-cols-[220px_1fr] gap-5 md:gap-12 py-12 border-t border-white/10","children":[["$","div",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"hidden md:block mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","h2",null,{"className":"text-lg font-semibold text-white md:sticky md:top-24 h-fit","children":"What I Learned"}]]}],["$","div",null,{"className":"text-[15px] leading-relaxed text-neutral-300 space-y-4","children":["$undefined","$undefined",["$","ul",null,{"className":"space-y-3 pt-1","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Rate limits are the real architecture driver"," "]}],"Meta's per-business-use-case throttling shaped more decisions than anything else — delta sync, async report jobs, and background workers all exist primarily to stay under the ceiling."]}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Model the vendor's constraints, not just its data"," "]}],"Getting CBO budgets, archival states, and async job lifecycles right in the schema mattered far more than the obvious campaign/ad-set/ad fields, and skipping them early would have meant painful migrations later."]}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Eventual consistency needs a source of truth"," "]}],"Meta doesn't always reflect a write immediately, so treating my synced Postgres mirror as the UI's source of truth — reconciled against Meta on a cadence — was the only way to keep the interface stable and honest."]}]]}],["$","li","3",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 rounded-full bg-pink-500 shrink-0"}],["$","span",null,{"children":[["$","span",null,{"className":"font-semibold text-white","children":["Mixing UI libraries has a real cost"," "]}],"Three component systems gave me the right widget for each job but a heavier bundle and occasional style clashes; if I did it again I'd standardize on one kit plus Tailwind and only reach outside it for a genuinely irreplaceable component."]}]]}]]}]]}]]}]
