1e:T671,{"@context":"https://schema.org","@graph":[{"@type":"CollectionPage","@id":"http://localhost:5000/workspace#webpage","url":"http://localhost:5000/workspace","name":"Workspace & Projects | MD. Sajjad Hossain","isPartOf":{"@id":"http://localhost:5000/#website"},"about":{"@id":"http://localhost:5000/#person"},"inLanguage":"en-US"},{"@type":"ItemList","name":"Projects by MD. Sajjad Hossain","numberOfItems":9,"itemListElement":[{"@type":"ListItem","position":1,"url":"http://localhost:5000/work/personal-portfolio","name":"Personal Portfolio"},{"@type":"ListItem","position":2,"url":"http://localhost:5000/work/nextype","name":"NexType"},{"@type":"ListItem","position":3,"url":"http://localhost:5000/work/downly","name":"Downly"},{"@type":"ListItem","position":4,"url":"http://localhost:5000/work/glasswind","name":"Glasswind"},{"@type":"ListItem","position":5,"url":"http://localhost:5000/work/automation-platform","name":"Automation Social Media Platform"},{"@type":"ListItem","position":6,"url":"http://localhost:5000/work/facebook-campaign-analyzer","name":"Facebook Campaign Analyzer"},{"@type":"ListItem","position":7,"url":"http://localhost:5000/work/employee-management-system","name":"Employee Management System"},{"@type":"ListItem","position":8,"url":"http://localhost:5000/work/chat-application","name":"Chat Application"},{"@type":"ListItem","position":9,"url":"http://localhost:5000/work/planit","name":"Planit"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"http://localhost:5000"},{"@type":"ListItem","position":2,"name":"Workspace","item":"http://localhost:5000/workspace"}]}]}c:["$","$3","c",{"children":[["$","div",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1e"}}],["$","$L1f",null,{}],["$","div",null,{"className":"relative w-full overflow-clip bg-black ","children":[["$","$L20",null,{"data":[{"slug":"personal-portfolio","leftContent":{"title":"Personal Portfolio ","description":"A developer-first, full-stack portfolio that goes beyond a resume—combining refined UI/UX, smooth animations, and practical utility into a high-performance digital presence, optimized for SEO and accessibility. ","keyPoints":["SEO-first architecture with semantic HTML and 95+ Lighthouse scores.","Secure OAuth authentication via NextAuth (GitHub & Google).","Interactive MongoDB-powered guestbook showcasing full-stack capability.","Polished UI/UX with smooth Motion.dev animations and scroll effects.","Built-in scheduling via Cal.com with automated branded emails."],"chips":[{"name":"NEXT.JS","icon":"/svg/nextjs-icon.svg"},{"name":"REACT.JS","icon":"/svg/react.svg"},{"name":"TAILWIND CSS","icon":"/svg/tailwindcss-icon.svg"},{"name":"MONGODB","icon":"/svg/mongodb-icon.svg"},{"name":"NODE.JS","icon":"/svg/nodejs-icon.svg"},{"name":"FRAMER MOTION","icon":"/svg/framer-icon.svg"},{"name":"MOTION.DEV","icon":"/svg/motion.dev.svg"},{"name":"NEXT AUTH","icon":"/svg/nextauth.png"},{"name":"NODE MAILER","icon":"/svg/nodemailer.png"},{"name":"VERCEL","icon":"/svg/vercel-icon.svg"},{"name":"ANALYTICS","icon":"/svg/analytics.png"},{"name":"SEO","icon":"/svg/seo.png"}]},"rightContent":{"title":"Pitch Your Startup, Connect With Entrepreneurs","image":"/portfolio.png"}},{"slug":"nextype","leftContent":{"title":"NexType ","description":"A browser typing-speed test that measures WPM and accuracy in real time, plays a genuine mechanical keyboard sound, and lets you race friends live—with cloud-synced settings, streaks, a weak-key heatmap and a global leaderboard once you sign in. ","keyPoints":["Real-time WPM, accuracy & consistency with a real mechanical keyboard sound.","Modes for timed, words, quotes, code (JS/TS/Python) and endless zen typing.","Live 1v1 races over Pusher with server-authoritative finish order.","Cloud sync, daily streaks, a weak-key heatmap and a global leaderboard.","Installable, offline-ready PWA built with Serwist."],"chips":[{"name":"NEXT.JS","icon":"/svg/nextjs-icon.svg"},{"name":"REACT.JS","icon":"/svg/react.svg"},{"name":"TYPESCRIPT","icon":"/svg/typescript-icon.svg"},{"name":"TAILWIND CSS","icon":"/svg/tailwindcss-icon.svg"},{"name":"MOTION.DEV","icon":"/svg/motion.dev.svg"},{"name":"AUTH.JS","icon":"/svg/nextauth.png"},{"name":"VERCEL","icon":"/svg/vercel-icon.svg"}]},"rightContent":{"title":"A typing-speed test with real mechanical sound & live races","image":"/nextype.png"}},{"slug":"downly","leftContent":{"title":"Downly ","description":"A production Instagram downloader for public reels, posts, stories and carousels—media is extracted server-side through a swappable provider chain, and the browser only ever receives signed, expiring, same-origin links, so a raw CDN URL never reaches the client. ","keyPoints":["Public reels, posts, IGTV, stories and carousels, downloaded in original quality.","Real file downloads via a signed, expiring, same-origin streaming proxy.","In-browser MP3 extraction and carousel ZIP bundling, with no server-side transcoding.","Swappable extraction: providers tried in priority order, replaceable without touching the API or UI.","13 locales with right-to-left Arabic, every language tree pre-rendered at build time.","Installable PWA with an OS share target — share a reel straight from Instagram into Downly."],"chips":[{"name":"NEXT.JS","icon":"/svg/nextjs-icon.svg"},{"name":"REACT.JS","icon":"/svg/react.svg"},{"name":"TYPESCRIPT","icon":"/svg/typescript-icon.svg"},{"name":"TAILWIND CSS","icon":"/svg/tailwindcss-icon.svg"},{"name":"SHADCN/UI","icon":"/svg/shadcnui.png"},{"name":"MOTION.DEV","icon":"/svg/motion.dev.svg"},{"name":"NODE.JS","icon":"/svg/nodejs-icon.svg"},{"name":"VERCEL","icon":"/svg/vercel-icon.svg"},{"name":"SEO","icon":"/svg/seo.png"}]},"rightContent":{"title":"A public Instagram media downloader, in 13 languages","image":"/downly.png"}},{"slug":"glasswind","leftContent":{"title":"Glasswind ","description":"A glassmorphism React component library published on npm—21 accessible, GPU-animated frosted-glass components (buttons, modals, forms, overlays) plus hooks, shipped as a zero-runtime-dependency, tree-shakeable package for any React or Next.js app. ","keyPoints":["21 accessible frosted-glass components + 6 hooks, themeable via CSS variables.","Zero runtime dependencies; tree-shakeable ESM + CJS build with full TypeScript types.","GPU-only (transform/opacity) 60fps animations with dark mode & reduced-motion.","SSR-safe for Next.js; plain CSS, no Tailwind required.","Live on npm — install with npm install glasswind."],"chips":[{"name":"TYPESCRIPT","icon":"/svg/typescript-icon.svg"},{"name":"REACT.JS","icon":"/svg/react.svg"},{"name":"CSS3","icon":"/svg/css-3.svg"},{"name":"VITE","icon":"/svg/vitejs.svg"},{"name":"NPM","icon":"/svg/npm-icon.svg"},{"name":"VERCEL","icon":"/svg/vercel-icon.svg"}]},"rightContent":{"title":"A glassmorphism React component library on npm","image":"/glasswind.jpg"}},{"slug":"automation-platform","leftContent":{"title":"Automation Social Media Platform","description":"A full-stack automation platform built to streamline social media engagement across Instagram, WhatsApp, and Telegram. Designed for scale, it enables intelligent auto-replies, real-time alerts, and secure account access through a fast. ","keyPoints":["Secure Google authentication powered by NextAuth.","Cross-platform automation for Instagram, WhatsApp, and Telegram.","Real-time alerts for events like Instagram Reel engagement and activity spikes.","Modern, accessible UI built with shadcn/ui and responsive layouts."],"chips":[{"name":"NEXT.JS","icon":"/svg/nextjs-icon.svg"},{"name":"REACT.JS","icon":"/svg/react.svg"},{"name":"TAILWIND CSS","icon":"/svg/tailwindcss-icon.svg"},{"name":"POSTGRESQL","icon":"/svg/postgresql.svg"},{"name":"PRISMA","icon":"/svg/prisma-icon.svg"},{"name":"NODE.JS","icon":"/svg/nodejs-icon.svg"},{"name":"FRAMER MOTION","icon":"/svg/framer.svg"},{"name":"SHADCN/UI","icon":"/svg/shadcnui.png"},{"name":"NEXT AUTH","icon":"/svg/nextauth.png"},{"name":"VERCEL","icon":"/svg/vercel-icon.svg"}]},"rightContent":{"title":"A scalable automation for social media auto-replies","image":"/automation1.png"}},{"slug":"facebook-campaign-analyzer","leftContent":{"title":"Facebook Campaign Analyzer","description":"A full-stack Facebook ads management platform inspired by Meta Ads Manager, enabling users to create, manage, and optimize campaigns, ad sets, and ads with image and video creatives through a secure, scalable interface.","keyPoints":["Create and manage Facebook campaigns, ad sets, and ads in a structured workflow.","Run image and video ads across Facebook placements using the Meta Business API.","Secure authentication with NextAuth for protected campaign access.","Real-time campaign insights and status tracking for ads and ad sets.","Modern, responsive dashboard UI built for performance and usability."],"chips":[{"name":"NEXT.JS","icon":"/svg/nextjs-icon.svg"},{"name":"REACT.JS","icon":"/svg/react.svg"},{"name":"TAILWIND CSS","icon":"/svg/tailwindcss-icon.svg"},{"name":"POSTGRESQL","icon":"/svg/postgresql.svg"},{"name":"PRISMA","icon":"/svg/prisma-icon.svg"},{"name":"NODE.JS","icon":"/svg/nodejs-icon.svg"},{"name":"SHADCN/UI","icon":"/svg/shadcnui.png"},{"name":"NEXT AUTH","icon":"/svg/nextauth.png"},{"name":"MATERIAL UI","icon":"/svg/material-ui.svg"},{"name":"ANT DESIGN","icon":"/svg/antdesign.svg"},{"name":"APEXCHARTS","icon":"/svg/apexchart.svg"}]},"rightContent":{"title":"An enterprise-grade platform inspired by FB Ads Manager.","image":"/fb.png"}},{"slug":"employee-management-system","leftContent":{"title":"Employee Management System","description":"A full-stack, role-based employee management platform designed to handle multi-level access, task assignments, and secure data separation across teams through a structured and scalable dashboard system.","keyPoints":["Multi-role dashboards including Admin, Manager, Operator, Client, and multi-level Employees.","Granular role-based access control ensuring private and protected data for each user level.","Task assignment, tracking, and approval workflows across hierarchical roles.","Dedicated review and verification layers for monitoring work progress and performance.","Secure authentication and authorization for controlled access across all dashboards.","Modern, responsive interface built for clarity, scalability, and operational efficiency."],"chips":[{"name":"REACT.JS","icon":"/svg/react.svg"},{"name":"TAILWIND CSS","icon":"/svg/tailwindcss-icon.svg"},{"name":"MONGODB","icon":"/svg/mongodb-icon.svg"},{"name":"EXPRESS","icon":"/svg/express-icon.svg"},{"name":"NODE.JS","icon":"/svg/nodejs-icon.svg"},{"name":"MATERIAL UI","icon":"/svg/material-ui.svg"}]},"rightContent":{"title":"A full-stack, role-based EMS with multi-level access","image":"/employee.jpg"}},{"slug":"chat-application","leftContent":{"title":"Chat Application","description":"A modern, full-stack chat application built for real-time communication with secure authentication, responsive design, and a smooth, user-friendly messaging experience.","keyPoints":["Real-time one-to-one and group messaging with instant updates.","Secure user authentication for protected conversations.","Message delivery status and conversation history persistence.","Clean, responsive UI optimized for both desktop and mobile.","Scalable architecture designed for high-concurrency usage.","Smooth interactions and animations for a polished chat experience."],"chips":[{"name":"REACT.JS","icon":"/svg/react.svg"},{"name":"TAILWIND CSS","icon":"/svg/tailwindcss-icon.svg"},{"name":"MATERIAL UI","icon":"/svg/material-ui.svg"},{"name":"REDUX","icon":"/svg/redux.svg"},{"name":"SOCKET.IO","icon":"/svg/socket.svg"},{"name":"NODE.JS","icon":"/svg/nodejs-icon.svg"},{"name":"EXPRESS.JS","icon":"/svg/express-icon.svg"},{"name":"MONGODB","icon":"/svg/mongodb-icon.svg"},{"name":"WEBHOOKS","icon":"/svg/webhook.svg"}]},"rightContent":{"title":" Chat Application for secure, real-time communication.","image":"/chat.jpg"}},{"slug":"planit","leftContent":{"title":"Planit ","description":"A modern, full-stack task management platform designed to help you plan smarter, stay organized, and boost productivity. Built with a clean UI, smooth interactions, and secure authentication for a seamless daily workflow.","keyPoints":["Secure Google authentication with a personalized dashboard.","Create, manage, and track tasks with real-time MongoDB persistence.","Smart task organization with priorities and custom categories.","Clean, intuitive UI with smooth animations for a focused experience.","Designed for productivity with fast performance and responsive layouts."],"chips":[{"name":"REACT.JS","icon":"/svg/react.svg"},{"name":"TAILWIND CSS","icon":"/svg/tailwindcss-icon.svg"},{"name":"MONGODB","icon":"/svg/mongodb-icon.svg"},{"name":"EXPRESS","icon":"/svg/express-icon.svg"},{"name":"NODE.JS","icon":"/svg/nodejs-icon.svg"},{"name":"VERCEL","icon":"/svg/vercel-icon.svg"},{"name":"ANALYTICS","icon":"/svg/analytics.png"}]},"rightContent":{"title":"Organize your tasks in a smarter way","image":"/planit.png"}}]}],"$L21"]}]]}],null,"$L22"]}]
